                        "rawQuery": true,
                        "rawSql": "SELECT\n  TO_CHAR(\n    (AVG(EXTRACT(EPOCH FROM last_t)) * interval '1 second'),\n    'HH24:MI'\n  ) AS \"avg last elaludt\"\nFROM (\n  SELECT MAX(log_time) AS last_t\n  FROM zili_daily_log\n  WHERE daily_summary ILIKE '%elaludt%'\n    AND log_time IS NOT NULL\n    AND log_date < (SELECT MAX(log_date) FROM zili_daily_log)\n  GROUP BY log_date\n) sub;\n",
